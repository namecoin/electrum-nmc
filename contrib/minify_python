#!/bin/bash
#
# Minify Python source files in the electrum_nmc package using python-minifier.
# This reduces binary size, which is attractive for Tor Browser bundles and
# AppImage builds.
#
# Usage:
#   ./contrib/minify_python [--dry-run] [directory]
#
# If no directory is given, defaults to electrum_nmc/electrum.
# With --dry-run, prints the size savings without modifying files.
#
# Requires: python-minifier (pip install python-minifier)

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR/.."

DRY_RUN=0
TARGET_DIR=""

for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=1
            ;;
        *)
            TARGET_DIR="$arg"
            ;;
    esac
done

if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$PROJECT_ROOT/electrum_nmc/electrum"
fi

if ! python3 -c "import python_minifier" 2>/dev/null; then
    echo "Error: python-minifier is not installed."
    echo "Install it with: pip install python-minifier"
    exit 1
fi

TOTAL_BEFORE=0
TOTAL_AFTER=0
FILE_COUNT=0

while IFS= read -r -d '' pyfile; do
    before_size=$(stat -c%s "$pyfile" 2>/dev/null || stat -f%z "$pyfile" 2>/dev/null)

    minified=$(python3 -c "
import python_minifier
import sys

with open(sys.argv[1], 'r', encoding='utf-8') as f:
    source = f.read()

result = python_minifier.minify(
    source,
    filename=sys.argv[1],
    remove_annotations=True,
    remove_pass=True,
    remove_literal_statements=True,
    combine_imports=True,
    hoist_literals=False,
    rename_locals=False,
    rename_globals=False,
    remove_object_base=True,
    convert_posargs_to_args=True,
    preserve_shebang=True,
)

sys.stdout.write(result)
" "$pyfile" 2>/dev/null) || continue

    after_size=${#minified}

    if [ "$before_size" -gt "$after_size" ]; then
        TOTAL_BEFORE=$((TOTAL_BEFORE + before_size))
        TOTAL_AFTER=$((TOTAL_AFTER + after_size))
        FILE_COUNT=$((FILE_COUNT + 1))

        if [ "$DRY_RUN" -eq 0 ]; then
            echo "$minified" > "$pyfile"
        fi

        saved=$((before_size - after_size))
        pct=$((saved * 100 / before_size))
        echo "  $(basename "$pyfile"): ${before_size} -> ${after_size} bytes (saved ${saved} bytes, ${pct}%)"
    fi

done < <(find "$TARGET_DIR" -name "*.py" -not -path "*/__pycache__/*" -not -path "*/test*" -print0)

if [ "$FILE_COUNT" -gt 0 ]; then
    total_saved=$((TOTAL_BEFORE - TOTAL_AFTER))
    total_pct=$((total_saved * 100 / TOTAL_BEFORE))
    echo ""
    echo "Total: ${FILE_COUNT} files, ${TOTAL_BEFORE} -> ${TOTAL_AFTER} bytes (saved ${total_saved} bytes, ${total_pct}%)"
else
    echo "No files needed minification."
fi

if [ "$DRY_RUN" -eq 1 ]; then
    echo "(dry run — no files modified)"
fi
